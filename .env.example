# Phase 6 / 11 story narration (display-only). Clinical truth stays in the engine.
# STORY_LLM_MODE: off | mock | openai
# - off (default): Phase 5 deterministic director only
# - mock: local Phase 6 enricher without network (for demos/tests)
# - openai: call OpenAI when OPENAI_API_KEY is set (also auto-selected if key present)
STORY_LLM_MODE=off
STORY_NARRATION_ENABLED=true
STORY_NARRATION_RATE_LIMIT_PER_MIN=20
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=12000
